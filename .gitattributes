# ?????? Git LFS: binary assets that git cannot diff or merge ??????????????????????????????????????????????????????????????????
# Anything below is stored as an LFS pointer in history; the bytes live in LFS.

# Images / textures
*.png           filter=lfs binary
*.PNG           filter=lfs binary
*.jpg           filter=lfs binary
*.jpeg          filter=lfs binary
*.JPEG          filter=lfs binary
*.tga           filter=lfs binary
*.TGA           filter=lfs binary
*.tif           filter=lfs binary
*.tiff          filter=lfs binary
*.bmp           filter=lfs binary
*.exr           filter=lfs binary
*.hdr           filter=lfs binary
*.HDR           filter=lfs binary
*.psd           filter=lfs binary
*.psb           filter=lfs binary
*.gif           filter=lfs binary
*.webp          filter=lfs binary

# 3D / animation sources
*.fbx           filter=lfs binary
*.FBX           filter=lfs binary
*.obj           filter=lfs binary
*.blend         filter=lfs binary
*.max           filter=lfs binary
*.vrm           filter=lfs binary
*.vmd           filter=lfs binary
*.pmx           filter=lfs binary
*.pmd           filter=lfs binary
*.vpm           filter=lfs binary

# Audio / video
*.wav           filter=lfs binary
*.mp3           filter=lfs binary
*.ogg           filter=lfs binary
*.aif           filter=lfs binary
*.aiff          filter=lfs binary
*.mp4           filter=lfs binary
*.mov           filter=lfs binary
*.avi           filter=lfs binary

# Native / packaged binaries
*.dll           filter=lfs binary
*.so            filter=lfs binary
*.a             filter=lfs binary
*.dylib         filter=lfs binary
*.bundle        filter=lfs binary
*.unitypackage  filter=lfs binary
*.apk           filter=lfs binary
*.aab           filter=lfs binary
*.zip           filter=lfs binary

# Documents shipped with vendor packages
*.pdf           filter=lfs binary

