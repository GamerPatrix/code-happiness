# ── .NET ──
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
*.nupkg
*.user
TestResults/

# ── Python ──
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Secrets / local config ──
.env
.env.*
!.env.example
*.pem
*.pfx
appsettings.Development.json
*.local.json

# ── Media / model sources (large binaries stay out of git) ──
# *.fbx is NOT ignored: Unity needs every imported model next to its .meta, and
# .gitattributes routes FBX through Git LFS. Add it back only if you drop LFS.
*.vrm
*.vmd
*.pmx
*.psd
Assets/**/[Mm]odels/**
!**/[Mm]odels/*.meta
*.wav
*.mp3
*.ogg
!docs/**/*.mp3

# ── OS ──
Thumbs.db
.DS_Store
Desktop.ini
ehthumbs.db


# Third-party reference clones - read-only, never edited in place, never pushed
vendor/
