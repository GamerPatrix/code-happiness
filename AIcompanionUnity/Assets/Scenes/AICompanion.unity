  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CodeHappiness.Avatar.AvatarSittingPoint
  pointName: Couch left
  description: The near end of the living room sofa, right next to the arm rest.
    Sit here when you want to talk normally or lean an arm on the arm rest.
  kind: 0
  animations:
  - AnimationName: Sitting And Pointing
    Note: her free hand points at the TV while she leans on the arm rest
  - AnimationName: Sitting Clap
    Note: clapping while seated
  - AnimationName: Sitting Laughing
    Note: leaning back laughing against the arm rest
  - AnimationName: Sitting Clap (1)
    Note: 
  - AnimationName: Sitting Angry
    Note: 
  - AnimationName: Standing Clap
    Note: 'its a stand up from sitting clap then sit back down '
  - AnimationName: Female Sitting Pose (2)
    Note: 
  includeInPrompt: 1
  usePointRotation: 1
  idleMode: Sitting
  defaultAnimationName: Female Sitting Pose
