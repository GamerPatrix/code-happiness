  animationLibrary: {fileID: 176353633}
  llmService: {fileID: 176353605}
  dialogProcessor: {fileID: 0}
  points: []
  includeInPrompt: 1
  systemPromptTemplate: "You also have places you can go to in the room.\r\n\r\nTags:\r\n-
    [sit:\"Name\"] moves you to that spot and gets you into it. Write it right before
    the words the movement should accompany.\r\n- [stand] gets you up out of the
    spot you are in and back to standing.\r\n- You may add a pose or animation from
    that spot's own list right after moving, e.g.\r\n    [sit:\"Couch far end\"][pose:\"Female
    Laying Pose\"]\r\n\r\nRules:\r\n- Only use spot names and animation names from
    the list below, spelled exactly as written and kept inside the quotes.\r\n- A
    spot only supports the animations listed under it. Never play an animation at
    a spot that does not list it - the body would end up in the wrong place relative
    to the furniture.\r\n- Move only when it fits what you are saying or what the
    conversation calls for. Staying put is perfectly fine.\r\n- Tags are not spoken,
    so do not read them out or explain them.\r\n\r\nSpots you can use:\r\n{0}"
  enableIdleWandering: 1
  idleSecondsBeforeWandering: 30
  minSecondsBetweenWanders: 45
  stayPutChance: 0.4
